[gd_resource type="Resource" script_class="AntecedenteRPG" format=3]

[ext_resource type="Script" path="res://core/dados/antecedente_rpg.gd" id="1_jxkit"]

[resource]
script = ExtResource("1_jxkit")
no_jogo = true
id = &"nobre"
nome = "Nobre"
descricao = "Cresceu entre privilégios, etiqueta e intrigas de família."
atributos = Array[StringName]([&"forca", &"inteligencia", &"carisma"])
talento = &"perito"
pericias = Array[StringName]([&"historia", &"persuasao"])
ferramenta = "Jogo (à escolha)"
equipamento = "Ferramenta e pacote de equipamento do livro. O jogo só entregará o que já existe nele (por enquanto, nada)."
