[gd_resource type="Resource" script_class="AntecedenteRPG" format=3]

[ext_resource type="Script" path="res://core/dados/antecedente_rpg.gd" id="1_fcqx5"]

[resource]
script = ExtResource("1_fcqx5")
no_jogo = true
id = &"criminoso"
nome = "Criminoso"
descricao = "Ganhou a vida fora da lei, atento a becos e a quem o segue."
