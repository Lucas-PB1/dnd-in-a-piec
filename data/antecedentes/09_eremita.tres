[gd_resource type="Resource" script_class="AntecedenteRPG" format=3]

[ext_resource type="Script" path="res://core/dados/antecedente_rpg.gd" id="1_nre5i"]

[resource]
script = ExtResource("1_nre5i")
id = &"eremita"
nome = "Eremita"
descricao = "Passou anos isolado, em meditação, estudo ou penitência."
atributos = Array[StringName]([&"constituicao", &"sabedoria", &"carisma"])
