[gd_resource type="Resource" script_class="AntecedenteRPG" format=3]

[ext_resource type="Script" path="res://core/dados/antecedente_rpg.gd" id="1_3wxnt"]

[resource]
script = ExtResource("1_3wxnt")
no_jogo = true
id = &"marinheiro"
