[gd_resource type="Resource" script_class="AntecedenteRPG" format=3]

[ext_resource type="Script" path="res://core/dados/antecedente_rpg.gd" id="1_k7h0u"]

[resource]
script = ExtResource("1_k7h0u")
id = &"viajante"
nome = "Viajante"
descricao = "Cresceu sem teto fixo, sobrevivendo de favores e de bom senso nas estradas."
