[gd_resource type="Resource" script_class="AntecedenteRPG" format=3]

[ext_resource type="Script" path="res://core/dados/antecedente_rpg.gd" id="1_0510s"]

[resource]
script = ExtResource("1_0510s")
no_jogo = true
id = &"charlatao"
nome = "Charlatão"
descricao = "Vive de lábia: golpes, disfarces e histórias bem contadas."
