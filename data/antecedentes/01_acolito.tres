[ext_resource type="Script" path="res://core/dados/antecedente_rpg.gd" id="1_8g6ey"]

[resource]
script = ExtResource("1_8g6ey")
id = &"acolito"
nome = "Acólito"
descricao = "Serviu num templo, entre rezas, ritos e estudo dos textos sagrados."
