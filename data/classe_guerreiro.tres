[gd_resource type="Resource" script_class="ClasseRPG" format=3]

[ext_resource type="Script" path="res://core/dados/classe_rpg.gd" id="1_classe"]
[ext_resource type="Script" path="res://core/dados/pacote_inicial.gd" id="2_pacote"]
[ext_resource type="Resource" path="res://data/pacotes/guerreiro_a.tres" id="3_pacote_a"]
[ext_resource type="Resource" path="res://data/pacotes/guerreiro_b.tres" id="4_pacote_b"]

[resource]
script = ExtResource("1_classe")
nome = "Guerreiro"
dado_vida = 10
atributos_sugeridos = Dictionary[StringName, int]({
&"carisma": 10,
&"constituicao": 13,
&"destreza": 14,
&"forca": 15,
&"inteligencia": 8,
&"sabedoria": 12
})
salvaguardas_proficientes = Array[StringName]([&"forca", &"constituicao"])
proficiencias_armas = Array[StringName]([&"simples", &"marcial"])
treinamento_armaduras = Array[StringName]([&"leve", &"media", &"pesada", &"escudo"])
pacotes_iniciais = Array[ExtResource("2_pacote")]([ExtResource("3_pacote_a"), ExtResource("4_pacote_b")])
quantidade_maestrias = 3
