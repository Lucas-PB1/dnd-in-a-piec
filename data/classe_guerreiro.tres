[sub_resource type="Resource" id="BuildMedia"]
script = ExtResource("5_build")
nome = "Armadura média"
atributos = Dictionary[StringName, int]({
&"carisma": 8,
&"constituicao": 14,
&"destreza": 14,
&"forca": 15,
&"inteligencia": 10,
&"sabedoria": 10
})

[sub_resource type="Resource" id="BuildPesada"]
script = ExtResource("5_build")
nome = "Armadura pesada"
atributos = Dictionary[StringName, int]({
&"carisma": 8,
&"constituicao": 14,
&"destreza": 10,
&"forca": 15,
&"inteligencia": 10,
&"sabedoria": 14
})

[sub_resource type="Resource" id="BuildLeve"]
script = ExtResource("5_build")
nome = "Armadura leve"
atributos = Dictionary[StringName, int]({
&"carisma": 8,
&"constituicao": 14,
&"destreza": 15,
&"forca": 10,
&"inteligencia": 10,
&"sabedoria": 14
})

[sub_resource type="Resource" id="Hab_segundo_folego"]
script = ExtResource("6_habilidade")
id = &"segundo_folego"
nome = "Segundo Fôlego"
descricao = "Ação bônus: recupera 1d10 + seu nível em PV. São 2 usos por fase e voltam quando você entra numa fase nova. Aparece no HUD como Fôlego."
acao = &"folego"

[sub_resource type="Resource" id="Hab_maestria_armas"]
script = ExtResource("6_habilidade")
id = &"maestria_armas"
nome = "Maestrias"
descricao = "Você domina 3 tipos de arma, escolhidos na criação. Só com elas a maestria da arma vale (Derrubar, Atormentar, Empurrar e as outras)."

[sub_resource type="Resource" id="Hab_treinamento"]
script = ExtResource("6_habilidade")
id = &"treinamento"
nome = "Treinamento"
descricao = "Sabe usar armas simples e marciais, todas as armaduras e escudos. Salvaguardas de Força e Constituição somam seu bônus de proficiência."

[sub_resource type="Resource" id="Hab_pericias"]
script = ExtResource("6_habilidade")
id = &"pericias"
nome = "Perícias"
descricao = "Duas perícias treinadas, escolhidas na criação (abre com Percepção e Atletismo). A Percepção passiva decide se você vê um goblin escondido."

[sub_resource type="Resource" id="Hab_surto_acao"]
script = ExtResource("6_habilidade")
id = &"surto_acao"
nome = "Surto de Ação"
nivel_minimo = 2
descricao = "Uma vez por fase: o próximo ataque sai em dobro (dois golpes seguidos, cada um com a sua rolagem)."
acao = &"surto_acao"
requer = Array[StringName]([&"segundo_folego"])

[sub_resource type="Resource" id="Hab_mente_tatica"]
script = ExtResource("6_habilidade")
id = &"mente_tatica"
nome = "Mente Tática"
nivel_minimo = 2
descricao = "Quando falha num teste de habilidade, gasta um uso de Segundo Fôlego para somar 1d10. Só gasta se o bônus fizer passar. Liga e desliga no HUD."
requer = Array[StringName]([&"pericias", &"segundo_folego"])

[sub_resource type="Resource" id="Hab_subclasse"]
script = ExtResource("6_habilidade")
id = &"subclasse"
nome = "Subclasse"
nivel_minimo = 3
descricao = "No nível 3 o Guerreiro escolhe uma especialização. Campeão: crítico no 19–20, +proficiência na iniciativa (Atleta Notável), vantagem em Atletismo e meio deslocamento após um crítico."
requer = Array[StringName]([&"surto_acao", &"mente_tatica"])

[sub_resource type="Resource" id="Hab_ataque_extra"]
script = ExtResource("6_habilidade")
id = &"ataque_extra"
nome = "Ataque Extra"
nivel_minimo = 5
descricao = "Cada ataque vira dois golpes seguidos, cada um com a sua rolagem. Com o Surto de Ação são quatro. O golpe da outra mão (arma dupla) não dobra."
requer = Array[StringName]([&"surto_acao"])

[sub_resource type="Resource" id="Hab_mudanca_tatica"]
script = ExtResource("6_habilidade")
id = &"mudanca_tatica"
nome = "Mudança Tática"
nivel_minimo = 5
descricao = "Ao usar o Segundo Fôlego você ganha +15 pés de deslocamento por 3 segundos."
requer = Array[StringName]([&"segundo_folego"])

[resource]
script = ExtResource("1_classe")
atributos_sugeridos = Dictionary[StringName, int]({
&"carisma": 10,
&"constituicao": 13,
&"destreza": 14,
&"forca": 15,
&"inteligencia": 8,
&"sabedoria": 12
})
builds_sugeridos = Array[ExtResource("5_build")]([SubResource("BuildMedia"), SubResource("BuildPesada"), SubResource("BuildLeve")])
salvaguardas_proficientes = Array[StringName]([&"forca", &"constituicao"])
proficiencias_armas = Array[StringName]([&"simples", &"marcial"])
treinamento_armaduras = Array[StringName]([&"leve", &"media", &"pesada", &"escudo"])
pacotes_iniciais = Array[ExtResource("2_pacote")]([ExtResource("3_pacote_a"), ExtResource("4_pacote_b")])
quantidade_maestrias = 3
pericias_escolhiveis = Array[StringName]([&"acrobacia", &"lidar_com_animais", &"atletismo", &"historia", &"intuicao", &"intimidacao", &"persuasao", &"percepcao", &"sobrevivencia"])
quantidade_pericias = 2
pericias_sugeridas = Array[StringName]([&"percepcao", &"atletismo"])
usos_segundo_folego = 2
habilidades = Array[ExtResource("6_habilidade")]([SubResource("Hab_segundo_folego"), SubResource("Hab_maestria_armas"), SubResource("Hab_treinamento"), SubResource("Hab_pericias"), SubResource("Hab_surto_acao"), SubResource("Hab_mente_tatica"), SubResource("Hab_subclasse"), SubResource("Hab_ataque_extra"), SubResource("Hab_mudanca_tatica")])
