[ext_resource type="Script" path="res://core/dados/classe_rpg.gd" id="1_classe"]
[ext_resource type="Script" path="res://core/dados/armadura.gd" id="2_armadura"]
[ext_resource type="Resource" path="res://data/armaduras/cota_malha.tres" id="3_cota_malha"]
