[gd_resource type="Resource" script_class="TalentoRPG" format=3]

[ext_resource type="Script" path="res://core/dados/talento_rpg.gd" id="1_xytai"]

[resource]
script = ExtResource("1_xytai")
no_jogo = true
id = &"agarrador"
nome = "Agarrador"
resumo = "+1 em Força ou Destreza. O soco acertado agarra o alvo (uma vez por rodada): ele fica sem deslocamento, tenta escapar a cada rodada (CD 8 + Força + proficiência) e o herói o ataca com vantagem."
situacao = 0
motivo = "Decidido com o usuário (ver docs/talentos.md)."
atributos = Array[StringName]([&"forca", &"destreza"])
pontos_de_atributo = 1
