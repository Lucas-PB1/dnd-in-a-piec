[gd_resource type="Resource" script_class="TalentoRPG" format=3]

[ext_resource type="Script" path="res://core/dados/talento_rpg.gd" id="1_hfhru"]

[resource]
script = ExtResource("1_hfhru")
no_jogo = true
id = &"mestre_escudo"
nome = "Mestre em Escudos"
resumo = "+1 em Força. Com escudo, depois de acertar uma arma corpo a corpo o alvo faz salvaguarda de Força (CD 8 + Força + proficiência); se falhar, é empurrado 5 pés ou derrubado (alterna a cada uso), uma vez por rodada."
situacao = 0
motivo = "Regra pequena de combate."
atributos = Array[StringName]([&"forca"])
pontos_de_atributo = 1
