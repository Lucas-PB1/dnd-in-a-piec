[gd_resource type="Resource" script_class="TalentoRPG" format=3]

[ext_resource type="Script" path="res://core/dados/talento_rpg.gd" id="1_r3rt2"]

[resource]
script = ExtResource("1_r3rt2")
no_jogo = true
id = &"aumento_de_atributo"
nome = "Aumento no Valor de Atributo"
resumo = "+2 num atributo, ou +1 em dois (teto 20). Pode repetir."
situacao = 0
motivo = "A ficha já sabe somar o que o talento dá."
atributos = Array[StringName]([&"forca", &"destreza", &"constituicao", &"inteligencia", &"sabedoria", &"carisma"])
pontos_de_atributo = 2
repetivel = true
