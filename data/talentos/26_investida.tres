[gd_resource type="Resource" script_class="TalentoRPG" format=3]

[ext_resource type="Script" path="res://core/dados/talento_rpg.gd" id="1_y06ku"]

[resource]
script = ExtResource("1_y06ku")
no_jogo = true
id = &"investida"
nome = "Investida"
resumo = "+1 em Força ou Destreza. Depois de correr 10 pés em linha reta, o ataque soma 1d8 ou empurra 10 pés (um botão alterna o modo, uma vez por rodada). A corrida também fica 10 pés mais rápida."
situacao = 0
motivo = "Regra pequena de combate."
atributos = Array[StringName]([&"forca", &"destreza"])
pontos_de_atributo = 1
