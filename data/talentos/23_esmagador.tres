[gd_resource type="Resource" script_class="TalentoRPG" format=3]

[ext_resource type="Script" path="res://core/dados/talento_rpg.gd" id="1_yahap"]

[resource]
script = ExtResource("1_yahap")
no_jogo = true
id = &"esmagador"
nome = "Esmagador"
resumo = "+1 em Força ou Constituição. O acerto contundente empurra o alvo 5 pés (uma vez por rodada); o crítico dá vantagem ao próximo ataque contra ele."
situacao = 0
motivo = "O Empurrar da maestria já move."
atributos = Array[StringName]([&"forca", &"constituicao"])
pontos_de_atributo = 1
