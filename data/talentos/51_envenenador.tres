[gd_resource type="Resource" script_class="TalentoRPG" format=3]

[ext_resource type="Script" path="res://core/dados/talento_rpg.gd" id="1_jn7w4"]

[resource]
script = ExtResource("1_jn7w4")
no_jogo = true
id = &"envenenador"
nome = "Envenenador"
resumo = "+1 em Destreza ou Inteligência. Duas doses de veneno por fase: uma ação bônus (tecla N) passa a dose na arma e o acerto força salvaguarda de Constituição; falhou, leva 2d8 de veneno e fica Envenenado (desvantagem nos ataques). Também usa o item Veneno Básico."
situacao = 0
motivo = "Decidido: entra com o item Veneno Básico; exige o tipo veneno e a condição Envenenado."
atributos = Array[StringName]([&"destreza", &"inteligencia"])
pontos_de_atributo = 1
