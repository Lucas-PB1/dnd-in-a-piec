tipo_texto = "Gosma média, sem tendência"
descricao = "Uma poça cinzenta que se arrasta pelas trilhas úmidas e pelas ruínas. Não pensa nem negocia: só consome o que toca. O ácido do corpo corrói armas e armaduras."
dica = "O perigo é o desgaste: cada golpe de arma não mágica a enferruja. Leve uma arma reserva. Ácido, frio e fogo quase não a machucam."
