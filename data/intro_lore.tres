[gd_resource type="Resource" script_class="IntroLoreRPG" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/dados/intro_lore_rpg.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
titulo = "Um pedaço de aventura"
texto = "Goblins, gosmas e uma Quimera faminta saíram do mato achando que o mundo era o quintal delas. Você? Guerreiro, arma na mão e a ideia genial de que \"avançar\" já é um plano.

Boa sorte. Vai precisar."
